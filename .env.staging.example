# ---- Bplan STAGING environment (Revenue Stream Wizard) ----
# Reference only. Set these in the Render dashboard for the STAGING services.
# Do NOT reuse any production value. Do NOT commit real secrets.
#
# Branch: feature/revenue-stream-wizard
# Isolated from production (bplan2-api / bplan2-frontend).

# ============ bplan-staging-api (Web Service · Docker) ============

# Auth signing secrets — generate NEW strong random values (staging only).
JWT_SECRET_KEY=CHANGE_ME_staging_access_secret
JWT_REFRESH_SECRET_KEY=CHANGE_ME_staging_refresh_secret

# Staging admin (seeded on first boot when no admin exists) — NOT production.
ADMIN_EMAIL=staging-admin@example.com
ADMIN_PASSWORD=CHANGE_ME_strong_staging_password
ADMIN_FULL_NAME=Staging Administrator

# App behaviour
BP_SEED_ON_STARTUP=true
BP_STORAGE_BACKEND=json
BP_SEED_DEV_USERS=false
BP_ADMIN_RESET=false

# Cross-domain frontend <-> API
BP_COOKIE_SECURE=true
BP_COOKIE_SAMESITE=none
BP_CORS_ORIGINS=https://bplan-staging-frontend.onrender.com

# Persistent storage — set ONLY if a disk is mounted at /data (recommended).
# Omit entirely on the free tier (data will be ephemeral).
BP_DATA_DIR=/data

# PORT is provided by Render automatically — do not set it here.

# ============ bplan-staging-frontend (Static Site) ============
# Build-time only. Point at the STAGING API origin (redeploy after changing).
VITE_API_BASE=https://bplan-staging-api.onrender.com
