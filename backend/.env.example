# Backend environment for local development.
# Copy this file to `backend/.env` and fill in the values. `.env` is gitignored
# and auto-loaded on startup (see app/config.py). Real environment variables
# always take precedence over this file.

# --- AI narrative generation ---------------------------------------------
# Provider: "anthropic" or "openai". Only the matching key below is required.
AI_PROVIDER=anthropic

# Anthropic (Claude)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# OpenAI
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Optional tuning
# AI_MAX_TOKENS=1500
# AI_TIMEOUT_SECONDS=60

# TLS for outbound AI calls. If this machine is behind HTTPS inspection
# (corporate proxy / antivirus), either point at the interceptor's CA bundle:
# AI_CA_BUNDLE=C:\path\to\proxy-ca.pem
# or, for LOCAL DEV ONLY, skip verification (never do this in production):
# AI_SSL_VERIFY=false
